{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 31,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "use-gcc",
			"hidden": true,
			"environment": {
				"GCC_VERSION": "$penv{GCC_VERSION}"
			}
		},
		{
			"name": "release",
			"displayName": "Release",
			"description": "Configure Release build",
			"inherits": "use-gcc",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build-${presetName}",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VERIFYPN_GetDependencies": "ON",
				"VERIFYPN_Static": "ON",
				"VERIFYPN_MC_Simplification": "OFF",
				"VERIFYPN_TEST": "OFF"
			}
		},
		{
			"name": "mcc",
			"displayName": "Model Checking Competition",
			"description": "Configure Model Checking Competition build",
			"inherits": "release",
			"cacheVariables": {
				"VERIFYPN_Static": "OFF",
				"VERIFYPN_MC_Simplification": "ON"
			}
		},
		{
			"name": "debug",
			"displayName": "Debug",
			"description": "Configure Debug build",
			"inherits": "use-gcc",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build-${presetName}",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"VERIFYPN_GetDependencies": "ON",
				"VERIFYPN_Static": "OFF",
				"VERIFYPN_MC_Simplification": "OFF",
				"VERIFYPN_TEST": "OFF"
			}
		},
		{
			"name": "test",
			"displayName": "Test",
			"description": "Configure build with testing enabled",
			"inherits": "use-gcc",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build-${presetName}",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VERIFYPN_GetDependencies": "ON",
				"VERIFYPN_Static": "OFF",
				"VERIFYPN_MC_Simplification": "OFF",
				"VERIFYPN_TEST": "ON"
			}
		},
		{
			"name": "win64-release",
			"displayName": "Windows Release",
			"description": "Configure Windows Cross-Compile Release build",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build-${presetName}",
			"toolchainFile": "${sourceDir}/toolchain-x86_64-w64-mingw32.cmake",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VERIFYPN_GetDependencies": "ON",
				"VERIFYPN_Static": "ON",
				"VERIFYPN_MC_Simplification": "OFF",
				"VERIFYPN_TEST": "OFF"
			}
		}
	],
	"buildPresets": [
		{
			"name": "release-deps",
			"configurePreset": "release",
			"targets": [
				"ptrie-ext",
				"rapidxml-ext",
				"spot-ext",
				"glpk-ext"
			]
		},
		{
			"name": "release",
			"configurePreset": "release"
		},
		{
			"name": "mcc-deps",
			"configurePreset": "mcc",
			"targets": [
				"ptrie-ext",
				"rapidxml-ext",
				"spot-ext",
				"glpk-ext"
			]
		},
		{
			"name": "mcc",
			"configurePreset": "mcc"
		},
		{
			"name": "debug-deps",
			"configurePreset": "debug",
			"targets": [
				"ptrie-ext",
				"rapidxml-ext",
				"spot-ext",
				"glpk-ext"
			]
		},
		{
			"name": "debug",
			"configurePreset": "debug"
		},
		{
			"name": "test-deps",
			"configurePreset": "test",
			"targets": [
				"ptrie-ext",
				"rapidxml-ext",
				"spot-ext",
				"glpk-ext"
			]
		},
		{
			"name": "test-build",
			"configurePreset": "test"
		},
		{
			"name": "win64-release-deps",
			"configurePreset": "win64-release",
			"targets": [
				"ptrie-ext",
				"rapidxml-ext",
				"spot-ext",
				"glpk-ext"
			]
		},
		{
			"name": "win64-release",
			"configurePreset": "win64-release"
		}
	],
	"testPresets": [
		{
			"name": "test",
			"configurePreset": "test",
			"output": {
				"outputOnFailure": true
			}
		}
	],
	"workflowPresets": [
		{
			"name": "release",
			"displayName": "Release Workflow",
			"steps": [
				{
					"type": "configure",
					"name": "release"
				},
				{
					"type": "build",
					"name": "release-deps"
				},
				{
					"type": "build",
					"name": "release"
				}
			]
		},
		{
			"name": "debug",
			"displayName": "Debug Workflow",
			"steps": [
				{
					"type": "configure",
					"name": "debug"
				},
				{
					"type": "build",
					"name": "debug-deps"
				},
				{
					"type": "build",
					"name": "debug"
				}
			]
		},
		{
			"name": "mcc",
			"displayName": "Model Checking Competition Workflow",
			"steps": [
				{
					"type": "configure",
					"name": "mcc"
				},
				{
					"type": "build",
					"name": "mcc-deps"
				},
				{
					"type": "build",
					"name": "mcc"
				}
			]
		},
		{
			"name": "test",
			"displayName": "Test Workflow",
			"steps": [
				{
					"type": "configure",
					"name": "test"
				},
				{
					"type": "build",
					"name": "test-deps"
				},
				{
					"type": "build",
					"name": "test-build"
				},
				{
					"type": "test",
					"name": "test"
				}
			]
		},
		{
			"name": "win64-release",
			"displayName": "Windows Release Workflow",
			"steps": [
				{
					"type": "configure",
					"name": "win64-release"
				},
				{
					"type": "build",
					"name": "win64-release-deps"
				},
				{
					"type": "build",
					"name": "win64-release"
				}
			]
		}
	]
}
